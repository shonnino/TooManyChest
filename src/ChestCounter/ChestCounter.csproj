<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows app: the standby process has no window; the tool opens its own console (NativeConsole). -->
    <OutputType>WinExe</OutputType>
    <!-- Windows Forms + WebView2: the window of the graphical interface (GuiWindow). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Only ChestCounter.exe in the output: no documentation files of the packages next to it. -->
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AssemblyName>toomanychests</AssemblyName>
    <RootNamespace>ChestCounter</RootNamespace>
    <Version>1.5.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Single-file publish: the parser discovers its types by reflection, so no trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Small idle footprint: workstation, non-concurrent GC (no background GC thread) and a GC that gives memory back. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- The chest of the report, as the icon of the exe, its console window and the tray. -->
    <ApplicationIcon>Assets\toomanychests.ico</ApplicationIcon>
    <Product>toomanychests</Product>
    <Description>toomanychests</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\BarlowCondensed-ExtraBold.ttf" LogicalName="interface.ttf" />
    <EmbeddedResource Include="Assets\BarlowCondensed-Bold.ttf" LogicalName="secondary.ttf" />
    <EmbeddedResource Include="Assets\ChestDigits.ttf" LogicalName="digits.ttf" />
    <EmbeddedResource Include="Assets\ArchivoBlack-OFL.txt" />
    <EmbeddedResource Include="Assets\BarlowCondensed-OFL.txt" />
    <EmbeddedResource Include="Assets\Anton-Regular.ttf" LogicalName="wordmark.ttf" />
    <EmbeddedResource Include="Assets\Anton-OFL.txt" />
    <EmbeddedResource Include="Assets\toomanychests.png" LogicalName="brand.png" />
    <EmbeddedResource Include="Assets\toomanychests.ico" LogicalName="brand.ico" />
    <EmbeddedResource Include="Assets\Dashboard.css" LogicalName="dashboard.css" />
    <!-- What's new of this version: shown once after an update, and used as the GitHub release text (build.yml). -->
    <EmbeddedResource Include="..\..\RELEASE_NOTES.md" LogicalName="ReleaseNotes.md" />
    <!-- Treasure hunt data (weeks, prize ids, odds, Treasure Hours, notices): replaced at runtime by a newer copy from the repository. -->
    <EmbeddedResource Include="..\..\content\content.json" LogicalName="content.json" />
    <EmbeddedResource Include="..\..\assets\treasures\*.*" LogicalName="treasure-image/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
