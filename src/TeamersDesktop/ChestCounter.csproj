    <None Remove="ChestCounter.Assets.rewards.pickaxe-back-bling.png" />
    <None Remove="ChestCounter.Assets.rewards.pirate-shop-access.png" />
    <None Remove="ChestCounter.Assets.rewards.vehicle-decal.png" />
    <None Remove="ChestCounter.Assets.fonts.Anton-Regular.ttf" />
    <None Remove="ChestCounter.Assets.fonts.Inter_28pt-Bold.ttf" />
    <None Remove="ChestCounter.Assets.fonts.Inter_28pt-Regular.ttf" />
    <None Remove="ChestCounter.Assets.2xflaw-banner.jpg" />
